# Copy to .env (git-ignored). scripts/init-secrets.sh fills the secret values for you.

# Login name of the single Authelia user (must match config users file, see scripts/add-user.sh)
LISTEN_USER=doctor

# Random value Traefik injects as X-Listen-Proxy; the api rejects requests without it
LISTEN_PROXY_SECRET=

# Postgres password for the "listen" role
POSTGRES_PASSWORD=

# Host paths for persistent state
LISTEN_CONFIG_DIR=/vault/configs/listen-vault
LISTEN_DATA_DIR=/vault/listen-vault

# CPU tuning (Ryzen 7 3800X: 8 physical cores; 8 threads measured fastest, see docs/benchmarks.md)
LLM_THREADS=8
LLM_THREADS_BATCH=8
TTS_THREADS=8
OCR_JOBS=8

MAX_UPLOAD_MB=100

# Zotero (optional). Create an API key at zotero.org/settings/keys with library read access.
# Every item is imported and listed; nothing is processed until you start it (Queue, or Process all in
# Settings). PDF downloads need Zotero file storage (not WebDAV). Leave ZOTERO_API_KEY empty to turn it off.
# Optional: the numeric user ID. Leave empty; it is read from the API key.
ZOTERO_USER_ID=
ZOTERO_API_KEY=
ZOTERO_SYNC_MINUTES=30
