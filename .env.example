# Copy to .env (git-ignored). scripts/init-secrets.sh fills the secret values for you.

# Login name of the single Authelia user (must match config users file, see scripts/add-user.sh)
LISTEN_USER=doctor

# Random value Traefik injects as X-Listen-Proxy; the api rejects requests without it
LISTEN_PROXY_SECRET=

# Postgres password for the "listen" role
POSTGRES_PASSWORD=

# Host paths for persistent state
LISTEN_CONFIG_DIR=/vault/configs/listen-vault
LISTEN_DATA_DIR=/vault/listen-vault

# CPU tuning (Ryzen 7 3800X: 8 physical cores; 8 threads measured fastest, see docs/benchmarks.md)
LLM_THREADS=8
LLM_THREADS_BATCH=8
TTS_THREADS=8
OCR_JOBS=8

MAX_UPLOAD_MB=100
