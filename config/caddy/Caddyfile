# Local reverse proxy for the api and the web app. Sign-in is the api's job (accounts with a session cookie).
# Caddy adds the shared X-Listen-Proxy secret, so only this proxy can reach the api, and it sets the client
# address itself, so a client cannot pretend to come from another address (rate limits use it).
http://:8080 {
	reverse_proxy api:8000 {
		header_up X-Listen-Proxy {$LISTEN_PROXY_SECRET}
		header_up X-Forwarded-For {remote_host}
	}
}
