# Copy to .env and fill in. scripts/init-secrets.sh does this for you and generates the secrets.
# Every variable has a default in docker-compose.yml when it is left empty, except the three marked "required".

# Public address of the app, used in links in emails (no trailing slash).
PUBLIC_URL=

# Mail for the confirmation emails (docs/multi-user-plan.md). SMTP_HOST empty turns verification off:
# new accounts are then confirmed at once, and the api logs a warning.
# Infomaniak: SMTP_HOST=mail.infomaniak.com, SMTP_PORT=587 (STARTTLS), SMTP_USER and SMTP_FROM = the mailbox address.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Required. Shared secret between the Caddy proxy and the api. Generated by scripts/init-secrets.sh.
LISTEN_PROXY_SECRET=

# Required. Password of the "listen" database role. Generated by scripts/init-secrets.sh.
POSTGRES_PASSWORD=

# Port of the web app on 127.0.0.1 (default 8073; 8080 is often taken by other services)
LISTEN_PORT=

# Time zone for logs and timestamps, e.g. Europe/Zurich (default UTC)
TZ=

# Largest upload in MB (default 100)
MAX_UPLOAD_MB=

# Model layers on the GPU (default 99 = all). Lower it if the GPU has less than about 6 GB free VRAM; 0 runs on CPU only.
LLM_GPU_LAYERS=

# CPU threads (defaults 8). Set them to your physical core count; 8 was fastest on an 8-core Ryzen.
LLM_THREADS=
LLM_THREADS_BATCH=
TTS_THREADS=
OCR_JOBS=

