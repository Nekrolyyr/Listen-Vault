# Copy to .env and fill in. scripts/init-secrets.sh does this for you and generates the secrets.
# Every variable has a default in docker-compose.yml when it is left empty, except the three marked "required".

# Required. Login name for the web app. scripts/add-user.sh sets its password.
LISTEN_USER=

# Required. Shared secret between the Caddy proxy and the api. Generated by scripts/init-secrets.sh.
LISTEN_PROXY_SECRET=

# Required. Password of the "listen" database role. Generated by scripts/init-secrets.sh.
POSTGRES_PASSWORD=

# Port of the web app on 127.0.0.1 (default 8080)
LISTEN_PORT=

# Time zone for logs and timestamps, e.g. Europe/Zurich (default UTC)
TZ=

# Largest upload in MB (default 100)
MAX_UPLOAD_MB=

# CPU threads (defaults 8). Set them to your physical core count; 8 was fastest on an 8-core Ryzen.
LLM_THREADS=
LLM_THREADS_BATCH=
TTS_THREADS=
OCR_JOBS=

# Zotero (optional). Create an API key at zotero.org/settings/keys with library read access.
# Every item is imported and listed; nothing is processed until you start it (Queue, or Process all in
# Settings). PDF downloads need Zotero file storage (not WebDAV). Leave ZOTERO_API_KEY empty to turn it off.
# ZOTERO_USER_ID is optional: leave it empty and it is read from the API key.
ZOTERO_USER_ID=
ZOTERO_API_KEY=
ZOTERO_QUEUE_TAG=
ZOTERO_SYNC_MINUTES=
